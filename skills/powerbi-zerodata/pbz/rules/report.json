{
 "version": 1,
 "scope": "report",
 "note": "Rule logic lives in pbz/bpa.py. Threshold rules score severity x (1 + excess). Messages name pages, visuals and fields only, never values.",
 "rules": [
  {"id": "REDUCE_PAGES", "name": "Reduce number of pages per report", "category": "Performance", "object": "report", "severity": 1, "evidence": "metadata", "opinion": false, "threshold": 15,
   "message": "report {object} has {count} pages (limit {threshold})", "fix": "split the report or merge pages",
   "source": "concept: microsoft/semantic-link-labs report BPA (MIT)"},
  {"id": "REDUCE_BOOKMARKS", "name": "Reduce number of bookmarks per report", "category": "Maintenance", "object": "report", "severity": 1, "evidence": "metadata", "opinion": false, "threshold": 25,
   "message": "report {object} has {count} bookmarks (limit {threshold})", "fix": "remove stale bookmarks",
   "source": "pbz"},
  {"id": "REDUCE_VISUALS_ON_PAGE", "name": "Reduce the number of visible visuals on the page", "category": "Performance", "object": "page", "severity": 2, "evidence": "metadata", "opinion": false, "threshold": 20,
   "message": "page {object} has {count} visible visuals (limit {threshold})", "fix": "split the page, or use bookmarks / drillthrough",
   "source": "concept: NatVanG/fab-inspector Base-rules (MIT)"},
  {"id": "REDUCE_OBJECTS_WITHIN_VISUALS", "name": "Reduce the number of objects within visuals", "category": "Performance", "object": "visual", "severity": 1, "evidence": "metadata", "opinion": false, "threshold": 6,
   "message": "{visual_type} {object} binds {count} fields (limit {threshold})", "fix": "drop fields or split the visual",
   "source": "concept: NatVanG/fab-inspector Base-rules (MIT)"},
  {"id": "REDUCE_TOPN_FILTERS", "name": "Reduce usage of TopN filtering visuals by page", "category": "Performance", "object": "page", "severity": 2, "evidence": "metadata", "opinion": false, "threshold": 2,
   "message": "page {object} has {count} TopN filters (limit {threshold})", "fix": "use fewer TopN filters, or a RANKX measure",
   "source": "concept: NatVanG/fab-inspector Base-rules (MIT)"},
  {"id": "REDUCE_ADVANCED_FILTERS", "name": "Reduce usage of Advanced filtering visuals by page", "category": "Performance", "object": "page", "severity": 1, "evidence": "metadata", "opinion": false, "threshold": 3,
   "message": "page {object} has {count} advanced filters (limit {threshold})", "fix": "prefer basic filters or slicers",
   "source": "concept: NatVanG/fab-inspector Base-rules (MIT)"},
  {"id": "REDUCE_MEASURE_FILTERS", "name": "Reduce usage of filters on measures", "category": "Performance", "object": "page", "severity": 2, "evidence": "metadata", "opinion": false, "threshold": 2,
   "message": "page {object} has {count} filters on measures (limit {threshold})", "fix": "filter on columns, or fold the condition into the measure",
   "source": "concept: microsoft/semantic-link-labs report BPA (MIT)"},
  {"id": "AVOID_SHOW_ITEMS_WITH_NO_DATA", "name": "Avoid setting 'Show items with no data' on columns", "category": "Performance", "object": "visual", "severity": 2, "evidence": "metadata", "opinion": false,
   "message": "{visual_type} {object} shows items with no data", "fix": "turn off Show items with no data",
   "source": "concept: NatVanG/fab-inspector Base-rules, akhilannan/pbir-utils (MIT)"},
  {"id": "HIDE_TOOLTIP_DRILLTHROUGH_PAGES", "name": "Tooltip and drillthrough pages should be hidden", "category": "Formatting", "object": "page", "severity": 1, "evidence": "metadata", "opinion": false,
   "message": "{detail} page {object} is visible", "fix": "hide the page",
   "source": "concept: NatVanG/fab-inspector Base-rules, akhilannan/pbir-utils (MIT)"},
  {"id": "AVOID_TALL_PAGES", "name": "Avoid pages taller than one screen", "category": "Formatting", "object": "page", "severity": 1, "evidence": "metadata", "opinion": false, "threshold": 1080,
   "message": "page {object} is {count} px tall (limit {threshold})", "fix": "split the page",
   "source": "pbz"},
  {"id": "REMOVE_UNUSED_CUSTOM_VISUALS", "name": "Remove custom visuals which are not used in the report", "category": "Performance", "object": "custom_visual", "severity": 1, "evidence": "metadata", "opinion": false,
   "message": "custom visual {object} is declared but no visual uses it", "fix": "`pbz unused --remove --only custom_visual`",
   "source": "concept: NatVanG/fab-inspector Base-rules, akhilannan/pbir-utils (MIT)"},
  {"id": "AVOID_HARD_CODED_COLORS", "name": "Use theme colors instead of hard-coded colors", "category": "Formatting", "object": "visual", "severity": 1, "evidence": "metadata", "opinion": false,
   "message": "{visual_type} {object} has {count} hard-coded color(s)", "fix": "use theme colors (ThemeDataColor)",
   "source": "concept: NatVanG/fab-inspector Base-rules (MIT)"},
  {"id": "AVOID_IMPLICIT_MEASURES", "name": "Use explicit measures instead of implicit aggregations", "category": "Maintenance", "object": "visual", "severity": 1, "evidence": "metadata", "opinion": false,
   "message": "{visual_type} {object} aggregates {count} column(s) implicitly", "fix": "create explicit measures",
   "source": "concept: microsoft/semantic-link-labs report BPA (MIT)"},
  {"id": "FIX_INVALID_REFERENCES", "name": "Fix report objects which reference invalid semantic model objects", "category": "Error Prevention", "object": "field", "severity": 3, "evidence": "metadata", "opinion": false,
   "message": "{object} is not in the model", "fix": "rebind the field or restore the object",
   "source": "concept: microsoft/semantic-link-labs report BPA (MIT)"},
  {"id": "AVOID_REPORT_LEVEL_MEASURES", "name": "Move report-level measures into the model", "category": "Maintenance", "object": "report_measure", "severity": 1, "evidence": "metadata", "opinion": false,
   "message": "report-level measure {object}", "fix": "define it in the semantic model so every report shares it",
   "source": "concept: akhilannan/pbir-utils (MIT)"},
  {"id": "REMOVE_INVALID_BOOKMARKS", "name": "Remove bookmarks that point at missing pages or visuals", "category": "Error Prevention", "object": "bookmark", "severity": 2, "evidence": "metadata", "opinion": false,
   "message": "bookmark {object} points at a missing {detail}", "fix": "re-capture or delete the bookmark",
   "source": "concept: akhilannan/pbir-utils (MIT)"},
  {"id": "REMOVE_HIDDEN_VISUALS_NEVER_SHOWN", "name": "Remove hidden visuals that no bookmark shows", "category": "Maintenance", "object": "visual", "severity": 1, "evidence": "metadata", "opinion": false,
   "message": "hidden {visual_type} {object} is not part of any bookmark", "fix": "delete it",
   "source": "concept: akhilannan/pbir-utils (MIT)"},
  {"id": "REMOVE_UNREFERENCED_HIDDEN_PAGES", "name": "Remove hidden pages nothing links to", "category": "Maintenance", "object": "page", "severity": 1, "evidence": "metadata", "opinion": false,
   "message": "hidden page {object} has no navigation, tooltip or drillthrough pointing at it", "fix": "delete the page or link it",
   "source": "pbz"},
  {"id": "AVOID_PIE_CHARTS", "name": "Avoid pie and donut charts", "category": "Formatting", "object": "visual", "severity": 1, "evidence": "metadata", "opinion": false,
   "message": "{visual_type} {object}", "fix": "use a bar chart",
   "source": "pbz"},
  {"id": "GIVE_VISIBLE_PAGES_MEANINGFUL_NAMES", "name": "Give visible pages meaningful names", "category": "Formatting", "object": "page", "severity": 1, "evidence": "metadata", "opinion": false,
   "message": "page {object} keeps a default name", "fix": "rename the page",
   "source": "concept: NatVanG/fab-inspector Base-rules (MIT)"},
  {"id": "ENSURE_ALTTEXT", "name": "Visuals should have alternative text", "category": "Accessibility", "object": "visual", "severity": 1, "evidence": "metadata", "opinion": true,
   "message": "{visual_type} {object} has no alt text", "fix": "set General > Alt text",
   "source": "concept: NatVanG/fab-inspector Base-rules (MIT)"}
 ]
}
