#!/bin/sh
# PBZ owned offline checks v1: local gate with advisory scope
# Clarified under CI-7 Option A:
# pre-push tests the local tree, not the outgoing pushed commits.
# Protected hosted CI, not this local hook, is the authoritative merge gate.
set -e
root=$(git rev-parse --show-toplevel) || exit 1

head_tree=$(git -C "$root" rev-parse --verify -q 'HEAD^{tree}' 2>/dev/null || echo "unknown")
if [ "$head_tree" = "unknown" ]; then
  dirty="unknown"
elif status_output=$(git -C "$root" status --porcelain --untracked-files=normal 2>/dev/null); then
  if [ -n "$status_output" ]; then
    dirty="dirty"
  else
    dirty="clean"
  fi
else
  dirty="unknown"
fi

echo "pbz: pre-push checks the local working tree, not outgoing commits (HEAD tree: $head_tree; working tree: $dirty); protected hosted CI is the merge authority" >&2

# Drop hook git variables so suite fixtures cannot commit into this repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH
cd "$root/skills/powerbi-zerodata" || exit 1
export PYTHONIOENCODING=utf-8
echo "pbz: building the engine, then running the offline CI suites"
dotnet publish engine/PbzEngine.csproj -c Release -r win-x64 --self-contained false -o engine/bin
if command -v python >/dev/null 2>&1; then
  exec python tests/run_offline.py
fi
if command -v py >/dev/null 2>&1; then
  exec py -3 tests/run_offline.py
fi
echo "python is required to run the offline CI suites" >&2
exit 1
